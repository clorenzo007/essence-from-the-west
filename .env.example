# MongoDB — use MongoDB Atlas URI on Vercel (database name: essence)
DATABASE_URI=mongodb://127.0.0.1:27017/essence

# Payload — long random string (openssl rand -hex 32)
PAYLOAD_SECRET=change-me-to-a-secure-random-string

# Public site — set to https://your-domain.vercel.app in production
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Production auth cookies — share session on www + apex (optional override)
# PAYLOAD_COOKIE_DOMAIN=.reservaoeste.com.ar
NEXT_PUBLIC_SITE_NAME=RESERVA OESTE

# WhatsApp checkout — country code + number, no + or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Cloudinary — recommended for production media (all site images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=essence-from-the-west

# Vercel Blob — fallback if Cloudinary is not configured
BLOB_READ_WRITE_TOKEN=

# Pl@ntNet — identificación automática de especie por foto en el admin de
# Orquídeas (botón "Identificar planta"). Gratis: 500 identificaciones/día.
# Generar en https://my.plantnet.org/signup (no requiere tarjeta).
PLANTNET_API_KEY=
